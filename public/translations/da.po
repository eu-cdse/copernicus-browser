msgid ""
"The request to the imagery provider timed out. Please try again in a few "
"minutes."
msgstr "Anmodningen til billedudbyderen fik timeout. Prøv igen om nogle minutter."

msgid ""
"The imagery provider is temporarily unavailable. Please try again in a few "
"minutes."
msgstr "Billedudbyderen er midlertidigt utilgængelig. Prøv igen om nogle minutter."

msgid ""
"Your search couldn't be processed. This can happen when a search covers "
"many providers or a large area. Try narrowing your search and searching "
"again."
msgstr ""
"Din søgning kunne ikke behandles. Det kan ske, når en søgning dækker mange "
"udbydere eller et stort område. Prøv at indsnævre din søgning og søg igen."

msgid ""
"Unable to reach the imagery provider. Please check your internet connection "
"and try again."
msgstr ""
"Billedudbyderen kunne ikke kontaktes. Kontrollér din internetforbindelse, "
"og prøv igen."

#, javascript-format
msgid ""
"Too many requests to ${ provider }. Please wait a moment and try again, or "
"narrow your search."
msgstr ""
"For mange anmodninger til ${ provider }. Vent et øjeblik og prøv igen, "
"eller indsnævr din søgning."

#, javascript-format
msgid ""
"Showing the available results. Some sources did not respond, so more "
"results may be available: ${ errorMessage }"
msgstr ""
"Viser de tilgængelige resultater. Nogle kilder svarede ikke, så der kan "
"være flere tilgængelige resultater: ${ errorMessage }"

msgid ""
"The imagery provider is currently receiving too many requests. Please wait "
"a moment and try your search again."
msgstr ""
"Billedudbyderen modtager i øjeblikket for mange anmodninger. Vent et "
"øjeblik, og prøv din søgning igen."

