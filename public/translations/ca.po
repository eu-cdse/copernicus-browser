msgstr "Codi FUA"

msgid "FUA name"
msgstr "Nom de la FUA"

msgid "Minimal mapping unit"
msgstr "Unitat mínima de cartografia"

msgid "Minimal mapping unit label"
msgstr "Etiqueta de la unitat mínima de cartografia"

msgid "Minimal mapping width"
msgstr "Amplada mínima de cartografia"

