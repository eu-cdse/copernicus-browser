msgstr "Šūnas ID"

msgid "Country code"
msgstr "Valsts kods"

msgid "FUA code"
msgstr "FUA kods"

msgid "FUA name"
msgstr "FUA nosaukums"

msgid "Minimal mapping unit"
msgstr "Minimālā kartēšanas vienība"

msgid "Minimal mapping unit label"
msgstr "Minimālās kartēšanas vienības etiķete"

msgid "Minimal mapping width"
msgstr "Minimālais kartēšanas platums"

msgid "Minimal mapping width label"
msgstr "Minimālā kartēšanas platuma etiķete"

