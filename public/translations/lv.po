msgid ""
"Too many requests to ${ provider }. Please wait a moment and try again, or "
"narrow your search."
msgstr ""
"Pārāk daudz pieprasījumu uz ${ provider }. Lūdzu, uzgaidiet brīdi un "
"mēģiniet vēlreiz vai sašauriniet meklēšanu."

