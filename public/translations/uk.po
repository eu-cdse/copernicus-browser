msgstr "Не вдалося проаналізувати геометрію WKT."

msgid "Could not parse the GeoJSON geometry."
msgstr "Не вдалося проаналізувати геометрію GeoJSON."

msgid "Enter a valid MGRS or GEOREF reference."
msgstr "Введіть дійсне посилання MGRS або GEOREF."

msgid "Enter four numeric values for minX, minY, maxX and maxY."
msgstr "Введіть чотири числові значення для minX, minY, maxX і maxY."

msgid "minX must be less than maxX, and minY must be less than maxY."
msgstr "minX має бути меншим за maxX, а minY — меншим за maxY."

