msgstr "Minimale Kartierungseinheit"

msgid "Minimal mapping unit label"
msgstr "Bezeichnung der minimalen Kartierungseinheit"

msgid "Minimal mapping width"
msgstr "Minimale Kartierungsbreite"

msgid "Minimal mapping width label"
msgstr "Bezeichnung der minimalen Kartierungsbreite"

