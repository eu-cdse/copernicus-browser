msgid ""
"The request to the imagery provider timed out. Please try again in a few "
"minutes."
msgstr ""
"Kuvatarjoajalle lähetetty pyyntö aikakatkaistiin. Yritä uudelleen muutaman "
"minuutin kuluttua."

msgid ""
"The imagery provider is temporarily unavailable. Please try again in a few "
"minutes."
msgstr ""
"Kuvatarjoaja ei ole tilapäisesti käytettävissä. Yritä uudelleen muutaman "
"minuutin kuluttua."

msgid ""
"Your search couldn't be processed. This can happen when a search covers "
"many providers or a large area. Try narrowing your search and searching "
"again."
msgstr ""
"Hakuasi ei voitu käsitellä. Näin voi käydä, kun haku kattaa useita "
"tarjoajia tai laajan alueen. Rajaa hakua ja hae uudelleen."

msgid ""
"Unable to reach the imagery provider. Please check your internet connection "
"and try again."
msgstr ""
"Kuvatarjoajaan ei saatu yhteyttä. Tarkista internetyhteytesi ja yritä "
"uudelleen."

#, javascript-format
msgid ""
"Too many requests to ${ provider }. Please wait a moment and try again, or "
"narrow your search."
msgstr ""
"Liian monta pyyntöä tarjoajalle ${ provider }. Odota hetki ja yritä "
"uudelleen tai rajaa hakua."

#, javascript-format
msgid ""
"Showing the available results. Some sources did not respond, so more "
