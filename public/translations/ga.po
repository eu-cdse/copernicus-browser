msgid ""
"The request to the imagery provider timed out. Please try again in a few "
"minutes."
msgstr ""
"Chuaigh an t-iarratas chuig an soláthraí íomhánna in éag. Bain triail eile "
"as i gceann cúpla nóiméad."

msgid ""
"The imagery provider is temporarily unavailable. Please try again in a few "
"minutes."
msgstr ""
"Níl an soláthraí íomhánna ar fáil go sealadach. Bain triail eile as i "
"gceann cúpla nóiméad."

msgid ""
"Your search couldn't be processed. This can happen when a search covers "
"many providers or a large area. Try narrowing your search and searching "
"again."
msgstr ""
"Níorbh fhéidir do chuardach a phróiseáil. Is féidir seo tarlú nuair a "
"chlúdaíonn cuardach a lán soláthraithe nó limistéar mór. Déan do chuardach "
"a chúngú agus cuardaigh arís."

msgid ""
"Unable to reach the imagery provider. Please check your internet connection "
"and try again."
msgstr ""
"Níorbh fhéidir teacht ar an soláthraí íomhánna. Seiceáil do cheangal "
"idirlín agus bain triail eile as."

#, javascript-format
msgid ""
"Too many requests to ${ provider }. Please wait a moment and try again, or "
"narrow your search."
msgstr ""
"An iomarca iarratas chuig ${ provider }. Fan nóiméad agus bain triail eile "
"as, nó cúngaigh do chuardach."

#, javascript-format
msgid ""
"Showing the available results. Some sources did not respond, so more "
"results may be available: ${ errorMessage }"
