msgstr "Home"

msgid "Shading"
msgstr "Schaduwwerking"

msgid "Sphere mode"
msgstr "Bolmodus"

msgid "Eye height"
msgstr "Ooghoogte"

msgid "Cannot load the image"
msgstr "Kan de afbeelding niet laden"

