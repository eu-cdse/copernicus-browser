msgid "False Color 13, 5, 2"
msgstr "Hamis szín 13, 5, 2"

msgid "Based on the combination of bands (B13 - B07) / (B13 + B07)"
msgstr "A (B13 - B07) / (B13 + B07) csatornakombináció alapján"

msgid "Based on bands 12,8,2"
msgstr "A 12, 8, 2 csatornák alapján"

