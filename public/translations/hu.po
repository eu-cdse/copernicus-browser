msgstr "A 8, 6, 4 csatorna kombinációja alapján"

msgid "Enhanced Vegetation Index"
msgstr "Továbbfejlesztett vegetációs index"

msgid "Based on the combination: BSI, B08, B11"
msgstr "A következő kombináció alapján: BSI, B08, B11"

msgid "Classified NDMI for irrigation"
msgstr "Osztályozott NDMI öntözéshez"

msgid "Based on bands B11, B08, B02"
