msgstr "Ezt az adatterméket az EUMETSAT dolgozta fel."

msgid "Cell id"
msgstr "Cella azonosító"

msgid "Country code"
msgstr "Országkód"

msgid "FUA code"
msgstr "FUA kód"

msgid "FUA name"
msgstr "FUA név"

msgid "Minimal mapping unit"
msgstr "Minimális térképezési egység"

msgid "Minimal mapping unit label"
msgstr "Minimális térképezési egység címkéje"

msgid "Minimal mapping width"
msgstr "Minimális térképezési szélesség"

msgid "Minimal mapping width label"
msgstr "Minimális térképezési szélesség címkéje"

msgid "Product delivery date"
msgstr "Termék szállítási dátuma"

