msgid ""
"Showing the available results. Some sources did not respond, so more "
"results may be available: ${ errorMessage }"
msgstr ""
"Prikazani so razpoložljivi rezultati. Nekateri viri se niso odzvali, zato "
"je morda na voljo več rezultatov: ${ errorMessage }"
