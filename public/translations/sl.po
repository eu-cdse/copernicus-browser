msgstr "Omejitve dostopa"

msgid "Fees"
msgstr "Pristojbine"

msgid "Remove collection"
msgstr "Odstrani zbirko"

msgid "Search layers…"
msgstr "Iskanje slojev …"

msgid "Metadata"
msgstr "Metapodatki"

msgid "No layers match"
msgstr "Ni ujemajočih se slojev"

