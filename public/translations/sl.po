msgstr "Razred 2021"

msgid "Class 2018"
msgstr "Razred 2018"

msgid "Code 2021"
msgstr "Koda 2021"

msgid "Code 2018"
msgstr "Koda 2018"

msgid "Country"
msgstr "Država"

msgid "Urban area"
msgstr "Urbano območje"

msgid "Street tree layer"
msgstr "Sloj uličnih dreves"

