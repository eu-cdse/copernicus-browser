msgstr "Ta strežnik mora za nalaganje tukaj podpirati HTTPS."

#, javascript-format
msgid "This server is already loaded as \"${ duplicate.name }\"."
msgstr "Ta strežnik je že naložen kot »${ duplicate.name }«."

msgid "The server took too long to respond. Please try again."
msgstr "Strežnik se je predolgo odzival. Poskusite znova."

#, javascript-format
msgid ""
"The server returned an error (HTTP ${ err.status }). Check the URL and try "
"again."
msgstr ""
"Strežnik je vrnil napako (HTTP ${ err.status }). Preverite URL in poskusite "
"znova."

msgid ""
"Could not reach the server. It may be offline or may not allow cross-origin "
"(CORS) access."
msgstr ""
"Strežnika ni bilo mogoče doseči. Morda je nedosegljiv ali pa ne dovoljuje "
"dostopa med različnimi izvori (CORS)."

msgid "Could not load capabilities. Check the URL and try again."
msgstr ""
"Zmožnosti (capabilities) ni bilo mogoče naložiti. Preverite URL in "
"poskusite znova."

#, javascript-format
msgid ""
"This server requires WMS ${ result.version }, which isn't supported here "
"(only WMS 1.1.1)."
msgstr ""
"Ta strežnik zahteva WMS ${ result.version }, ki tu ni podprt (podprt je "
"samo WMS 1.1.1)."

