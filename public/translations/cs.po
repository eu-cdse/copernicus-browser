msgid ""
"The request to the imagery provider timed out. Please try again in a few "
"minutes."
msgstr ""
"Požadavek na poskytovatele snímků vypršel. Zkuste to prosím znovu za "
"několik minut."

msgid ""
"The imagery provider is temporarily unavailable. Please try again in a few "
"minutes."
msgstr ""
"Poskytovatel snímků je dočasně nedostupný. Zkuste to prosím znovu za "
"několik minut."

msgid ""
"Your search couldn't be processed. This can happen when a search covers "
"many providers or a large area. Try narrowing your search and searching "
"again."
msgstr ""
"Vaše hledání se nepodařilo zpracovat. K tomu může dojít, pokud hledání "
"zahrnuje mnoho poskytovatelů nebo rozsáhlou oblast. Zkuste hledání zúžit a "
"vyhledat znovu."

msgid ""
"Unable to reach the imagery provider. Please check your internet connection "
"and try again."
msgstr ""
"Poskytovatele snímků se nepodařilo kontaktovat. Zkontrolujte prosím "
"připojení k internetu a zkuste to znovu."

#, javascript-format
msgid ""
"Too many requests to ${ provider }. Please wait a moment and try again, or "
"narrow your search."
msgstr ""
"Příliš mnoho požadavků na ${ provider }. Chvíli počkejte a zkuste to znovu, "
"nebo zúžte hledání."

#, javascript-format
msgid ""
"Showing the available results. Some sources did not respond, so more "
"results may be available: ${ errorMessage }"
msgstr ""
"Zobrazují se dostupné výsledky. Některé zdroje neodpověděly, proto mohou "
"být k dispozici další výsledky: ${ errorMessage }"

msgid ""
"The imagery provider is currently receiving too many requests. Please wait "
"a moment and try your search again."
msgstr ""
"Poskytovatel snímků v současnosti přijímá příliš mnoho požadavků. Chvíli "
"počkejte a zkuste hledání znovu."

