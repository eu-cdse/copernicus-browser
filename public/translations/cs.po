msgid "FUA code"
msgstr "Kód FUA"

msgid "FUA name"
msgstr "Název FUA"

msgid "Minimal mapping unit"
msgstr "Minimální mapovací jednotka"

msgid "Minimal mapping unit label"
msgstr "Označení minimální mapovací jednotky"

msgid "Minimal mapping width"
msgstr "Minimální mapovací šířka"

msgid "Minimal mapping width label"
msgstr "Označení minimální mapovací šířky"

msgid "Product delivery date"
msgstr "Datum dodání produktu"

msgid "SDI resource identifier"
msgstr "Identifikátor zdroje SDI"

msgid "Day night flag"
msgstr "Příznak den/noc"

msgid "Horizontal tile number"
msgstr "Číslo horizontální dlaždice"

msgid "Vertical tile number"
msgstr "Číslo vertikální dlaždice"

