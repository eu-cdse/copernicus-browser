msgstr "GSD"

msgid "Name of the data collection or series."
msgstr "Název datové kolekce nebo série."

msgid "Estimated percentage of cloud coverage in the scene."
msgstr "Odhadované procento oblačnosti na scéně."

msgid "Short name of the instrument used to capture the data (e.g., SAR, MSI)."
msgstr "Zkrácený název přístroje použitého k pořízení dat (např. SAR, MSI)."

msgid "Identifier of the dataset within a collection."
msgstr "Identifikátor datové sady v rámci kolekce."

msgid "Full name or path of the dataset."
msgstr "Úplný název nebo cesta datové sady."

msgid "Type of product generated, indicating processing level and acquisition mode."
msgstr "Typ vygenerovaného produktu, udávající úroveň zpracování a režim snímání."

msgid "Start time of the satellite sensing or data acquisition."
msgstr "Počátek družicového snímání nebo pořizování dat."

msgid "Unique name or identifier of the product."
msgstr "Jedinečný název nebo identifikátor produktu."

msgid "Short name of the satellite platform (e.g., SENTINEL-1, SENTINEL-2)."
msgstr "Zkrácený název družicové platformy (např. SENTINEL-1, SENTINEL-2)."

msgid "Identifier for the platform variant (e.g., A or B for Sentinel satellites)."
msgstr "Identifikátor varianty platformy (např. A nebo B u družic Sentinel)."

msgid "Orbit number relative to a fixed reference cycle."
msgstr "Číslo dráhy vzhledem k pevnému referenčnímu cyklu."

msgid "Processing timeliness category (e.g., Near Real-Time, Offline)."
msgstr "Kategorie lhůty zpracování (např. téměř v reálném čase, offline)."

msgid ""
"Direction of the satellite orbit during acquisition (e.g., ASCENDING, "
"DESCENDING)."
msgstr "Směr dráhy družice během snímání (např. ASCENDING, DESCENDING)."

msgid "Acquisition mode used by the instrument (e.g., IW, SM)."
msgstr "Režim snímání použitý přístrojem (např. IW, SM)."

msgid "Radar polarisation modes used (e.g., VV, VH)."
msgstr "Použité radarové polarizační režimy (např. VV, VH)."

msgid "Absolute orbit number at time of acquisition."
msgstr "Číslo absolutní dráhy v době snímání."

msgid "Mode used for processing the product, if applicable."
msgstr "Režim použitý ke zpracování produktu, pokud je relevantní."

msgid "Identifiers of the swath(s) used in the acquisition (e.g., IW1, IW2, IW3)."
msgstr "Identifikátory pruhů záběru použitých při snímání (např. IW1, IW2, IW3)."

msgid "Indicates whether the product is currently available for download."
msgstr "Udává, zda je produkt aktuálně dostupný ke stažení."

msgid "Source organization or system that produced the data."
msgstr "Zdrojová organizace nebo systém, který data vytvořil."

msgid "Version of the processing software used to generate the product."
msgstr "Verze zpracovatelského softwaru použitého k vytvoření produktu."

msgid "Identifier for Sentinel-2 collection (e.g., S2_MSI_L1C)."
msgstr "Identifikátor kolekce Sentinel-2 (např. S2_MSI_L1C)."

msgid "Class of the product, indicating type or access constraints."
msgstr "Třída produktu, udávající typ nebo omezení přístupu."

msgid "Spatial resolution of the dataset in meters."
msgstr "Prostorové rozlišení datové sady v metrech."

msgid "Identifier conforming to Earth Observation Product standards."
msgstr "Identifikátor odpovídající standardům produktů pro pozorování Země."

msgid "Incidence angle across the track of the satellite, typically in degrees."
msgstr "Úhel dopadu napříč dráhou družice, obvykle ve stupních."

msgid "Classification of the resolution level (e.g., High, Medium)."
msgstr "Klasifikace úrovně rozlišení (např. vysoké, střední)."

msgid "Identifier for the delivery package or transfer bundle."
msgstr "Identifikátor dodacího balíčku nebo přenosové sady."

msgid "Full name of the satellite platform."
msgstr "Úplný název družicové platformy."

msgid "Identifier of the spatial grid cell containing the product."
msgstr "Identifikátor buňky prostorové mřížky obsahující produkt."

msgid "Time interval between repeat acquisitions over the same location."
msgstr "Časový interval mezi opakovanými snímáními téhož místa."

msgid "Version number of the dataset definition."
msgstr "Číslo verze definice datové sady."

msgid "File format used for the data product (e.g., SAFE, GeoTIFF)."
msgstr "Formát souboru použitý pro datový produkt (např. SAFE, GeoTIFF)."

msgid "Geographic area the data product covers or is relevant to."
msgstr "Zeměpisná oblast, kterou datový produkt pokrývá nebo které se týká."

msgid "Globally unique identifier for the dataset."
msgstr "Globálně jedinečný identifikátor datové sady."

msgid "Subsystem or data component involved in the acquisition or processing."
msgstr "Podsystém nebo datová složka zapojená do snímání nebo zpracování."

msgid "Human-readable label for the grid cell or tile."
msgstr "Čitelné označení buňky mřížky nebo dlaždice."

msgid "Spacing of the grid in meters used for spatial referencing."
msgstr "Rozteč mřížky v metrech používaná pro prostorové referencování."

msgid "Short, human-friendly name of the dataset."
msgstr "Krátký, srozumitelný název datové sady."

msgid "Time period over which data is consolidated for processing or delivery."
msgstr "Časové období, za které jsou data konsolidována pro zpracování nebo dodání."

msgid ""
"The reference date for the data, often representing when it is intended to "
"be used."
msgstr "Referenční datum dat, často udávající, kdy mají být použita."

msgid "We could not restore the compared layers. Please try opening the link again."
msgstr "Porovnávané vrstvy se nepodařilo obnovit. Zkuste odkaz otevřít znovu."

msgid "Next"
msgstr "Další"

msgid "Previous"
msgstr "Předchozí"

msgid "End tutorial"
msgstr "Ukončit návod"

msgid "Remind me later"
msgstr "Připomenout později"

msgid "Close"
msgstr "Zavřít"

msgid "Don't show again"
msgstr "Už nezobrazovat"

msgid ""
"# Welcome to Copernicus Browser!\n"
"\n"
"A complete archive of Sentinel-1, Sentinel-2, Sentinel-3, Sentinel-5P, "
"Sentinel-6,  \n"
"Copernicus Contributing Missions (Optical, SAR and DEM), Copernicus Land "
"Monitoring Service (CLMS), and Sentinel-1 and Sentinel-2 Global Mosaics "
"data in one place.\n"
"\n"
"[About Copernicus Browser "
"page](https://documentation.dataspace.copernicus.eu/Applications/Browser."
"html)  \n"
"[Available data "
"collections](https://dataspace.copernicus.eu/explore-data/data-collections)"
msgstr ""
"# Vítejte v Copernicus Browser!\n"
"\n"
"Úplný archiv dat Sentinel-1, Sentinel-2, Sentinel-3, Sentinel-5P, "
"Sentinel-6,  \n"
"Copernicus Contributing Missions (optických, SAR a DEM), Copernicus Land "
"Monitoring Service (CLMS) a globálních mozaik Sentinel-1 a Sentinel-2 na "
"jednom místě.\n"
"\n"
"[Stránka o Copernicus "
"Browser](https://documentation.dataspace.copernicus.eu/Applications/Browser."
"html)  \n"
"[Dostupné datové "
"kolekce](https://dataspace.copernicus.eu/explore-data/data-collections)"

msgid ""
"#### Quick overview of Copernicus Browser features\n"
"\n"
"Copernicus Browser serves as a central hub for accessing, exploring and "
"utilising the wealth of Earth observation and environmental \n"
"data provided by the Sentinel-1, Sentinel-2, Sentinel-3, Sentinel-5P, "
"Sentinel-6, Copernicus Contributing Missions (Optical, SAR and DEM), \n"
"and Sentinel-1 and Sentinel-2 Global Mosaics (see details "
"[here](https://documentation.dataspace.copernicus.eu/Data.html)). You "
"simply \n"
"go to your area of interest, select data sources, time range and cloud "
"coverage, and inspect the resulting data.\n"
"\n"
"You can continue the tutorial by clicking on the \"Next\" button or you can "
"close it. By clicking the info \n"
"icon <span class=\"icon large-padding\"><i class=\"fa fa-info\"></i></span> "
"in the top right \n"
"corner you can always resume the tutorial in case you closed it by mistake "
"or because you wanted to try something out."
msgstr ""
"#### Stručný přehled funkcí Copernicus Browser\n"
"\n"
"Copernicus Browser slouží jako centrální místo pro přístup k bohatým datům "
"o pozorování Země a životním prostředí, jejich prozkoumávání a využívání. \n"
"Data poskytují Sentinel-1, Sentinel-2, Sentinel-3, Sentinel-5P, Sentinel-6, "
"Copernicus Contributing Missions (optické, SAR a DEM) \n"
"a globální mozaiky Sentinel-1 a Sentinel-2 (podrobnosti "
"[zde](https://documentation.dataspace.copernicus.eu/Data.html)). Jednoduše \n"
"přejdete do své oblasti zájmu, vyberete zdroje dat, časové období a "
"oblačnost a prohlédnete si výsledná data.\n"
"\n"
"V návodu můžete pokračovat kliknutím na tlačítko „Další“, nebo jej můžete "
"zavřít. Kliknutím na ikonu informací \n"
"<span class=\"icon large-padding\"><i class=\"fa fa-info\"></i></span> v "
"pravém horním \n"
"rohu můžete návod kdykoli obnovit, pokud jste jej zavřeli omylem nebo "
"proto, že jste si chtěli něco vyzkoušet."

msgid ""
"Anonymous use of the Browser gives you access with limited functionality. "
"To be able to use all functions, you need a free account. \n"
"**Logged-in users** can use their custom themes, save and load pins, "
"measure distances, create a timelapse and use the extended image download."
msgstr ""
"Anonymní používání prohlížeče vám poskytuje přístup s omezenou funkčností. "
"Chcete-li používat všechny funkce, potřebujete bezplatný účet. \n"
"**Přihlášení uživatelé** mohou používat vlastní motivy, ukládat a načítat "
"piny, měřit vzdálenosti, vytvářet časosběr a používat rozšířené stahování "
"obrázků."

msgid ""
"In the **Visualise tab** you can:\n"
"- Search for a **Date**.\n"
"- Select a **Theme**.\n"
"- Choose a **Collection**.\n"
"- Select a **Visualisation Layer**.\n"
"\n"
"You can change the **Date** (type in or select it from the calendar) and "
"set the cloud coverage. You can choose between \n"
"single date, mosaic and time range: ![Single](icon) ![Mosaic](icon) ![Time "
"Range](icon).\n"
"\n"
"The **Configurations** dropdown offers you different preconfigured themes "
"and your own custom configured instances if\n"
"you are logged in. To create an instance, go to your [personal "
"dashboard](https://shapps.dataspace.copernicus.eu/dashboard/).\n"
"\n"
"You can select a desired data source in the **Data Collections**. You can "
"read explanations of the satellites by clicking \n"
"on the information icon next to the name of the data collection. Here you "
"can also switch between different panels: \n"
"![Layers](icon) Layers, ![Highlights](icon) Highlights, ![Compare "
"mode](icon) Compare mode and ![Pins](icon) Pins."
msgstr ""
"Na **kartě Vizualizace** můžete:\n"
"- Vyhledat **datum**.\n"
"- Vybrat **motiv**.\n"
"- Zvolit **kolekci**.\n"
"- Vybrat **vizualizační vrstvu**.\n"
"\n"
"**Datum** můžete změnit (zadat jej nebo vybrat z kalendáře) a nastavit "
"oblačnost. Můžete si vybrat mezi \n"
"jedním datem, mozaikou a časovým obdobím: ![Single](icon) ![Mosaic](icon) "
"![Time Range](icon).\n"
"\n"
"Rozbalovací nabídka **Konfigurace** nabízí různé předkonfigurované motivy a "
"vaše vlastní nakonfigurované instance, pokud\n"
"jste přihlášeni. Chcete-li instanci vytvořit, přejděte na svůj [osobní "
"panel](https://shapps.dataspace.copernicus.eu/dashboard/).\n"
"\n"
"Požadovaný zdroj dat můžete vybrat v části **Datové kolekce**. Vysvětlení k "
"družicím si přečtete kliknutím \n"
"na ikonu informací vedle názvu datové kolekce. Zde také můžete přepínat "
"mezi různými panely: \n"
"![Layers](icon) Vrstvy, ![Highlights](icon) Zajímavosti, ![Compare "
"mode](icon) Režim porovnání a ![Pins](icon) Piny."

msgid ""
"You can select different pre-installed or custom spectral band combinations "
"to visualise data for the selected result.\n"
"\n"
"Some of the common options:\n"
"- **True Color** - Visual interpretation of land cover\n"
"- **False Color** - Visual interpretation of vegetation\n"
"- **NDVI** - Vegetation index\n"
"- **Moisture index** - Moisture index\n"
"- **SWIR** - Shortwave-infrared index\n"
"- **NDWI** - Normalized Difference Water Index\n"
"- **NDSI** - Normalized Difference Snow Index\n"
"\n"
"Most visualisations are given a description and a legend, which you can "
"view by clicking on the expand sign ![expand](icon).\n"
"Each of the layers offers an option to add it to Compare or Pins by "
"clicking <span class=\"icon\"><i class=\"fas fa-plus\"></i> Add to</span>.\n"
"Based on your action, the Compare and Pins panels will include added layers "
"![compare-with-badge](icon) ![pins-with-badge](icon)\n"
"which you can further organise and analyse under each tab.\n"
"\n"
"Click on the **Custom visualisation** option to select custom band "
"combinations, index combinations or write your own classification script "
"for the\n"
"visualisation of data. You can also use custom scripts, which are stored "
"elsewhere, either on Google Drive, GitHub or in our\n"
"[Custom script repository](https://custom-scripts.sentinel-hub.com/). Paste "
"the URL of the script into the text box in the advanced script editing "
"panel\n"
"and click Refresh. The custom script of preconfigured layers can be edited "
"by choosing the code icon ![code-icon](icon).\n"
"\n"
"You can select <span class=\"icon\"><i class=\"fa fa-sliders\"></i></span> "
"**Show effects and advanced options** like the sampling method, advanced "
"RGB effects or apply \n"
"contrast (gain) and luminance (gamma). To return to preconfigured layers, "
"click <span class=\"icon\"><i class=\"fa fa-paint-brush\"></i></span> "
"**Show visualisations**.\n"
"**Share** your visualisation on social media by clicking on the share icon "
"<span class=\"icon\"><i class=\"fas fa-share-alt\"></i></span>."
msgstr ""
"Pro zobrazení dat vybraného výsledku můžete zvolit různé přednastavené nebo "
"vlastní kombinace spektrálních pásem.\n"
"\n"
"Některé běžné možnosti:\n"
"- **Skutečné barvy** - vizuální interpretace krajinného pokryvu\n"
"- **Nepravé barvy** - vizuální interpretace vegetace\n"
"- **NDVI** - vegetační index\n"
"- **Index vlhkosti** - index vlhkosti\n"
"- **SWIR** - index krátkovlnného infračerveného záření\n"
"- **NDWI** - normalizovaný diferenční vodní index\n"
"- **NDSI** - normalizovaný diferenční sněhový index\n"
"\n"
"Většina vizualizací má popis a legendu, které zobrazíte kliknutím na symbol "
"rozbalení ![expand](icon).\n"
"Každá z vrstev nabízí možnost přidat ji do Porovnání nebo do Pinů kliknutím "
"na <span class=\"icon\"><i class=\"fas fa-plus\"></i> Přidat do</span>.\n"
"Podle vaší akce budou panely Porovnání a Piny obsahovat přidané vrstvy "
"![compare-with-badge](icon) ![pins-with-badge](icon),\n"
"které můžete dále uspořádat a analyzovat na příslušné kartě.\n"
"\n"
"Klikněte na možnost **Vlastní vizualizace** a vyberte vlastní kombinace "
"pásem, kombinace indexů nebo napište vlastní klasifikační skript pro\n"
"vizualizaci dat. Můžete také použít vlastní skripty uložené jinde, buď na "
"Disku Google, na GitHubu, nebo v našem\n"
"[úložišti vlastních skriptů](https://custom-scripts.sentinel-hub.com/). "
"Vložte URL skriptu do textového pole v panelu pokročilé úpravy skriptu\n"
"a klikněte na Obnovit. Vlastní skript předkonfigurovaných vrstev lze "
"upravit výběrem ikony kódu ![code-icon](icon).\n"
"\n"
"Můžete vybrat <span class=\"icon\"><i class=\"fa fa-sliders\"></i></span> "
"**Zobrazit efekty a pokročilé možnosti**, například metodu vzorkování, "
"pokročilé efekty RGB nebo použít \n"
"kontrast (gain) a jas (gamma). Chcete-li se vrátit k předkonfigurovaným "
"vrstvám, klikněte na <span class=\"icon\"><i class=\"fa "
"fa-paint-brush\"></i></span> **Zobrazit vizualizace**.\n"
"**Sdílejte** svou vizualizaci na sociálních sítích kliknutím na ikonu "
"sdílení <span class=\"icon\"><i class=\"fas fa-share-alt\"></i></span>."

msgid ""
"If you choose one of the preconfigured themes under **Configurations**, you "
"will be able to select from a highlights list under the Highlights panel.\n"
"\n"
"Each highlight has a description accessible under the dropdown icon "
"![expand-description](icon)."
msgstr ""
"Pokud v části **Konfigurace** zvolíte jeden z předkonfigurovaných motivů, "
"budete moci vybírat ze seznamu zajímavostí na panelu Zajímavosti.\n"
"\n"
"Každá zajímavost má popis dostupný pod ikonou rozbalení "
"![expand-description](icon)."

msgid ""
"Here you will find all visualisations that you added by clicking <span "
"class=\"icon\"><i class=\"fas fa-plus\"></i> Add to</span> on \n"
"the layers under the Layers panel.\n"
"\n"
"There are two modes of comparing:\n"
"- **Opacity** (drag opacity slider left or right to fade between compared "
"images)\n"
"- **Split** (drag split slider left or right to set the boundary between "
"compared images)"
msgstr ""
"Zde najdete všechny vizualizace, které jste přidali kliknutím na <span "
"class=\"icon\"><i class=\"fas fa-plus\"></i> Přidat do</span> u \n"
"vrstev na panelu Vrstvy.\n"
"\n"
"Existují dva režimy porovnání:\n"
"- **Průhlednost** (tažením posuvníku průhlednosti doleva nebo doprava "
"přelévejte mezi porovnávanými obrázky)\n"
"- **Rozdělení** (tažením posuvníku rozdělení doleva nebo doprava nastavíte "
"hranici mezi porovnávanými obrázky)"

msgid ""
"The **Pins** panel contains your pinned (favourite/saved) items. Pinned "
"items contain information about location, data source \n"
"and its specific layer, zoom level and time. To reorder the pins, choose "
"among the options in the **Order by** dropdown.\n"
"\n"
"You have several ways to interact with each pin:\n"
"- Change **order** - by clicking on the move icon <span class=\"icon\"><i "
"class=\"fa fa-ellipsis-v\"></i><i class=\"fa fa-ellipsis-v\"></i></span> \n"
"in the top left corner of the pin and dragging the pin up or down the list.\n"
"- **Rename** - by clicking on the pencil icon ![rename](icon) next to the "
"pin's name.\n"
"- Add to the **Compare** panel - by clicking on the compare icon "
"![compare](icon).\n"
"- Enter a **description** - by clicking on the expand icon ![expand](icon).\n"
"- **Remove** - by clicking the remove icon <span class=\"icon\"><i "
"class=\"fas fa-trash\"></i></span>.\n"
"- **Zoom** to the pin's location - by clicking on the Lat/Lon.\n"
"\n"
"In the line above your pins, you have different options that apply to all "
"pins:\n"
"- Create your own story from pins - by clicking on **Story**.\n"
"- Share your pins with others via a link - by clicking on **Share**.\n"
"- Export pins as a JSON file - by clicking on **Export**.\n"
"- Import pins from a JSON file - by clicking on **Import**.\n"
"- Delete all pins - by clicking on **Clear**."
msgstr ""
"Panel **Piny** obsahuje vaše připnuté (oblíbené/uložené) položky. Připnuté "
"položky obsahují informace o poloze, zdroji dat \n"
"a jeho konkrétní vrstvě, úrovni přiblížení a času. Piny můžete přeuspořádat "
"výběrem z možností v rozbalovací nabídce **Seřadit podle**.\n"
"\n"
"S každým pinem můžete pracovat několika způsoby:\n"
"- Změnit **pořadí** - kliknutím na ikonu přesunu <span class=\"icon\"><i "
"class=\"fa fa-ellipsis-v\"></i><i class=\"fa fa-ellipsis-v\"></i></span> \n"
"v levém horním rohu pinu a přetažením pinu nahoru nebo dolů v seznamu.\n"
"- **Přejmenovat** - kliknutím na ikonu tužky ![rename](icon) vedle názvu "
"pinu.\n"
"- Přidat na panel **Porovnání** - kliknutím na ikonu porovnání "
"![compare](icon).\n"
"- Zadat **popis** - kliknutím na ikonu rozbalení ![expand](icon).\n"
"- **Odebrat** - kliknutím na ikonu odebrání <span class=\"icon\"><i "
"class=\"fas fa-trash\"></i></span>.\n"
"- **Přiblížit** na polohu pinu - kliknutím na zeměpisnou šířku/délku.\n"
"\n"
"V řádku nad vašimi piny jsou různé možnosti, které se týkají všech pinů:\n"
"- Vytvořit vlastní příběh z pinů - kliknutím na **Příběh**.\n"
"- Sdílet své piny s ostatními pomocí odkazu - kliknutím na **Sdílet**.\n"
"- Exportovat piny jako soubor JSON - kliknutím na **Exportovat**.\n"
"- Importovat piny ze souboru JSON - kliknutím na **Importovat**.\n"
"- Smazat všechny piny - kliknutím na **Vymazat**."

msgid ""
"The **WMS/WMTS panel** lets you add third-party map layers to Copernicus "
"Browser via a service **GetCapabilities URL**.\n"
"\n"
"To **add a service** - paste its GetCapabilities URL into the input field "
"and click the add button <span class=\"icon\"><i class=\"fas "
"fa-plus\"></i></span> (or press Enter). The service and its layers appear "
"alongside the standard collections.\n"
"\n"
"Once a service is loaded, you can:\n"
"- View **service details** (description, access constraints and fees) - by "
"clicking on the info icon <span class=\"icon\"><i class=\"fa "
"fa-info\"></i></span> next to the service name.\n"
"- **Select** a service - by clicking on its name; the active service is "
"marked with a checkmark and its layers are listed below.\n"
"- **Remove** a service - by clicking on the remove icon <span "
"class=\"icon\"><i class=\"fas fa-trash\"></i></span>.\n"
"\n"
"In the layer list you can **search** layers by name, page through them with "
"the <span class=\"icon\"><i class=\"fas fa-chevron-left\"></i></span> and "
"<span class=\"icon\"><i class=\"fas fa-chevron-right\"></i></span> "
"controls, and pick how many layers to show per page. Click a layer to "
"display it on the map. On the active layer, use **Add to** <span "
"class=\"icon\"><i class=\"fas fa-plus\"></i></span> to add it to the "
"**Compare** or **Pins** panels."
msgstr ""
"Panel **WMS/WMTS** umožňuje přidat do Copernicus Browser mapové vrstvy "
"třetích stran prostřednictvím **adresy URL GetCapabilities** služby.\n"
"\n"
"Chcete-li **přidat službu**, vložte její URL GetCapabilities do vstupního "
"pole a klikněte na tlačítko přidání <span class=\"icon\"><i class=\"fas "
"fa-plus\"></i></span> (nebo stiskněte Enter). Služba a její vrstvy se "
"zobrazí vedle standardních kolekcí.\n"
"\n"
"Po načtení služby můžete:\n"
"- Zobrazit **podrobnosti o službě** (popis, omezení přístupu a poplatky) - "
"kliknutím na ikonu informací <span class=\"icon\"><i class=\"fa "
"fa-info\"></i></span> vedle názvu služby.\n"
"- **Vybrat** službu - kliknutím na její název; aktivní služba je označena "
"zaškrtnutím a její vrstvy jsou uvedeny níže.\n"
"- **Odebrat** službu - kliknutím na ikonu odebrání <span class=\"icon\"><i "
"class=\"fas fa-trash\"></i></span>.\n"
"\n"
"V seznamu vrstev můžete vrstvy **vyhledávat** podle názvu, procházet je "
"pomocí ovládacích prvků <span class=\"icon\"><i class=\"fas "
"fa-chevron-left\"></i></span> a <span class=\"icon\"><i class=\"fas "
"fa-chevron-right\"></i></span> a vybrat, kolik vrstev se má zobrazit na "
"stránce. Kliknutím na vrstvu ji zobrazíte na mapě. U aktivní vrstvy "
"použijte **Přidat do** <span class=\"icon\"><i class=\"fas "
"fa-plus\"></i></span> a přidejte ji na panel **Porovnání** nebo **Piny**."

msgid ""
"Under **Search** you can set:\n"
"- **Search criteria** by a product name.\n"
"- Choose from which **data sources** you want to receive the data by "
"selecting checkboxes. Where applicable, you can also set **filters**\n"
"such as satellite platform, orbit direction, relative orbit, number, "
"acquisition mode, product availability, timeliness, etc.\n"
"- Select the **time range** by either typing the date or selecting it from "
"the calendar. If you want to omit some of the months, enable\n"
"the **Filter by months** option and uncheck the non-relevant months.\n"
"\n"
"Once you hit Search you get a list of results. Each result is presented "
"with a preview image and relevant data specific to the data source.\n"
"For **product info** and **zooming to product**, click on the <span "
"class=\"icon\"><i class=\"fa fa-info-circle\"></i></span> and <span "
"class=\"icon\"><i class=\"fa fa-crosshairs\"></i></span> icons.\n"
"If you are logged in, you can click on ![workspace-add](icon) to **add a "
"product to your Copernicus Data Space Ecosystem Workspace**\n"
"to easily collect and process your satellite data. You can also **download "
"the product** by clicking on the download icon <span class=\"icon\"><i "
"class=\"fa fa-download\"></i></span>.\n"
"\n"
"Clicking on the Visualise button will open the **Visualise** tab for the "
"selected result."
msgstr ""
"Na kartě **Hledání** můžete nastavit:\n"
"- **Kritéria hledání** podle názvu produktu.\n"
"- Vyberte, z jakých **zdrojů dat** chcete data získat, zaškrtnutím políček. "
"Kde je to relevantní, můžete také nastavit **filtry**,\n"
"například družicovou platformu, směr dráhy, relativní dráhu, číslo, režim "
"snímání, dostupnost produktu, lhůtu zpracování atd.\n"
"- Vyberte **časové období** zadáním data nebo výběrem z kalendáře. Pokud "
"chcete některé měsíce vynechat, zapněte\n"
"možnost **Filtrovat podle měsíců** a zrušte zaškrtnutí nerelevantních "
"měsíců.\n"
"\n"
"Po stisknutí Hledat získáte seznam výsledků. Každý výsledek je zobrazen s "
"náhledem a relevantními údaji specifickými pro zdroj dat.\n"
"Pro **informace o produktu** a **přiblížení na produkt** klikněte na ikony "
"<span class=\"icon\"><i class=\"fa fa-info-circle\"></i></span> a <span "
"class=\"icon\"><i class=\"fa fa-crosshairs\"></i></span>.\n"
"Pokud jste přihlášeni, můžete kliknutím na ![workspace-add](icon) **přidat "
"produkt do svého pracovního prostoru Copernicus Data Space Ecosystem**,\n"
"abyste snadno shromažďovali a zpracovávali svá družicová data. Můžete také "
"**stáhnout produkt** kliknutím na ikonu stažení <span class=\"icon\"><i "
"class=\"fa fa-download\"></i></span>.\n"
"\n"
"Kliknutím na tlačítko Vizualizovat otevřete kartu **Vizualizace** pro "
"vybraný výsledek."

msgid ""
"Search for a location either by scrolling the map with a mouse or by "
"entering the location in the **Go to Place** field."
msgstr ""
"Vyhledejte místo posouváním mapy myší nebo zadáním místa do pole **Přejít "
"na místo**."

msgid ""
"Here you can select which base layer and overlays (borders, labels) are "
"shown on the map."
msgstr ""
"Zde můžete vybrat, která podkladová vrstva a překryvy (hranice, popisky) se "
"zobrazí na mapě."

msgid ""
"You can view the tutorial anytime by clicking on this info icon <span "
"class=\"icon large-padding\"><i class=\"fa fa-info\"></i></span>."
msgstr ""
"Návod si můžete kdykoli zobrazit kliknutím na tuto ikonu informací <span "
"class=\"icon large-padding\"><i class=\"fa fa-info\"></i></span>."

msgid ""
"This tool allows you to draw a polygon on the map and display the polygon's "
"size.\n"
"\n"
"All layers that return a single value (such as NDVI, Moisture Index, NDWI, "
"...) support viewing the index\n"
"for the selected area over time. Clicking the chart icon <span "
"class=\"icon\"><i class=\"fa fa-bar-chart\"></i></span> will\n"
"display the statistical information charts (you need to be logged in to use "
"this option). You can remove the polygon \n"
"by clicking the remove icon <span class=\"icon\"><i class=\"fa "
"fa-close\"></i></span>.\n"
"\n"
"You can also upload a KML/KMZ, GPX, WKT (in EPSG:4326) or GEOJSON/JSON file "
"with a polygon geometry using the\n"
"upload icon <span class=\"icon\"><i class=\"fa fa-upload\"></i></span>.\n"
"\n"
"The two sheets icon <span class=\"icon\"><i class=\"far "
"fa-copy\"></i></span> lets you copy the polygon coordinates as a \n"
"GEOJSON and the crosshair <span class=\"icon\"><i class=\"fa "
"fa-crosshairs\"></i></span> centers the map on the drawn polygon."
msgstr ""
"Tento nástroj umožňuje nakreslit na mapě polygon a zobrazit jeho velikost.\n"
"\n"
"Všechny vrstvy, které vracejí jedinou hodnotu (například NDVI, index "
"vlhkosti, NDWI, ...), podporují zobrazení indexu\n"
"pro vybranou oblast v čase. Kliknutím na ikonu grafu <span "
"class=\"icon\"><i class=\"fa fa-bar-chart\"></i></span> se\n"
"zobrazí grafy statistických informací (k použití této možnosti musíte být "
"přihlášeni). Polygon můžete odebrat \n"
"kliknutím na ikonu odebrání <span class=\"icon\"><i class=\"fa "
"fa-close\"></i></span>.\n"
"\n"
"Pomocí ikony nahrání <span class=\"icon\"><i class=\"fa "
"fa-upload\"></i></span> můžete také nahrát soubor KML/KMZ, GPX, WKT (v "
"EPSG:4326) nebo GEOJSON/JSON s geometrií polygonu.\n"
"\n"
"Ikona dvou listů <span class=\"icon\"><i class=\"far fa-copy\"></i></span> "
"umožňuje zkopírovat souřadnice polygonu jako \n"
"GEOJSON a zaměřovací kříž <span class=\"icon\"><i class=\"fa "
"fa-crosshairs\"></i></span> vycentruje mapu na nakreslený polygon."

msgid ""
"This tool allows you to draw a line on the map and display the line length.\n"
"\n"
"It also includes the **Elevation Profile**, a tool that allows you to "
"create the altitude profile by defining a line from point A to point B.\n"
"\n"
"You can also upload a KML/KMZ, GPX, WKT (in EPSG:4326) or GEOJSON/JSON file "
"using the upload icon <span class=\"icon\"><i class=\"fa "
"fa-upload\"></i></span>.\n"
"\n"
"The two sheets icon <span class=\"icon\"><i class=\"far "
"fa-copy\"></i></span> lets you copy the line coordinates as a \n"
"GEOJSON and the crosshair <span class=\"icon\"><i class=\"fa "
"fa-crosshairs\"></i></span> centers the map on the drawn line."
msgstr ""
"Tento nástroj umožňuje nakreslit na mapě linii a zobrazit její délku.\n"
"\n"
"Zahrnuje také **Výškový profil**, nástroj, který umožňuje vytvořit výškový "
"profil definováním linie z bodu A do bodu B.\n"
"\n"
"Pomocí ikony nahrání <span class=\"icon\"><i class=\"fa "
"fa-upload\"></i></span> můžete také nahrát soubor KML/KMZ, GPX, WKT (v "
"EPSG:4326) nebo GEOJSON/JSON.\n"
"\n"
"Ikona dvou listů <span class=\"icon\"><i class=\"far fa-copy\"></i></span> "
"umožňuje zkopírovat souřadnice linie jako \n"
"GEOJSON a zaměřovací kříž <span class=\"icon\"><i class=\"fa "
"fa-crosshairs\"></i></span> vycentruje mapu na nakreslenou linii."

msgid ""
"With this tool, you can mark a point on the map.\n"
"\n"
"You can also view statistical data for some layers by clicking on the chart "
"icon <span class=\"icon\"><i class=\"fa fa-bar-chart\"></i></span>. \n"
"You can remove the mark by clicking the remove icon <span class=\"icon\"><i "
"class=\"fa fa-close\"></i></span>."
msgstr ""
"Pomocí tohoto nástroje můžete označit bod na mapě.\n"
"\n"
"Pro některé vrstvy můžete také zobrazit statistická data kliknutím na ikonu "
"grafu <span class=\"icon\"><i class=\"fa fa-bar-chart\"></i></span>. \n"
"Značku můžete odebrat kliknutím na ikonu odebrání <span class=\"icon\"><i "
"class=\"fa fa-close\"></i></span>."

msgid ""
"With this tool, you can measure distances and areas on the map.\n"
"\n"
"Every mouse click creates a new point on the path. To stop adding points, "
"press the <code>Esc</code> key or double-click on the map.  \n"
"You can remove the measurement by clicking the remove icon <span "
"class=\"icon\"><i class=\"fa fa-close\"></i></span>."
msgstr ""
"Pomocí tohoto nástroje můžete měřit vzdálenosti a plochy na mapě.\n"
"\n"
"Každé kliknutí myší vytvoří na trase nový bod. Přidávání bodů ukončíte "
"stisknutím klávesy <code>Esc</code> nebo dvojitým kliknutím na mapu.  \n"
"Měření můžete odebrat kliknutím na ikonu odebrání <span class=\"icon\"><i "
"class=\"fa fa-close\"></i></span>."

msgid ""
"With this tool, you can download an image of visualised data for the "
"displayed location. You can choose to show \n"
"captions and you can add your own description. By enabling Analytical mode, "
"you can choose between various image formats, \n"
"image resolutions and coordinate systems. You can also select multiple "
"layers and download them as a <code>.zip</code> file.\n"
"\n"
"Click the download button <span class=\"icon\"><i class=\"fa "
"fa-download\"></i> Download</span> and your image(s) will \n"
"begin to download. The process can take a few seconds, depending on the "
"selected resolution and the number of selected layers.\n"
"\n"
"Before downloading, you can define an area of interest (AOI) by clicking on "
"the Area selection tool icon ![selection](icon).\n"
"Your data will be clipped to match this area."
msgstr ""
"Pomocí tohoto nástroje můžete stáhnout obrázek vizualizovaných dat pro "
"zobrazené místo. Můžete zvolit zobrazení \n"
"popisků a přidat vlastní popis. Zapnutím analytického režimu můžete vybírat "
"mezi různými formáty obrázků, \n"
"rozlišeními obrázků a souřadnicovými systémy. Můžete také vybrat více "
"vrstev a stáhnout je jako soubor <code>.zip</code>.\n"
"\n"
"Klikněte na tlačítko stažení <span class=\"icon\"><i class=\"fa "
"fa-download\"></i> Stáhnout</span> a váš obrázek (obrázky) se \n"
"začne stahovat. Proces může trvat několik sekund, podle zvoleného rozlišení "
"a počtu vybraných vrstev.\n"
"\n"
"Před stažením můžete definovat oblast zájmu (AOI) kliknutím na ikonu "
"nástroje výběru oblasti ![selection](icon).\n"
"Vaše data budou oříznuta podle této oblasti."

msgid ""
"With this tool (available to logged-in users), you can create a timelapse "
"animation of the visualised layer and displayed location.\n"
"\n"
"First, choose a time range. You can refine your search results further via "
"the **Filter by months** checkbox and/or by selecting one\n"
"image per defined period (orbit, day, week, month, year).\n"
"\n"
"Then press <span class=\"icon\"><i class=\"fa fa-search\"></i> "
"Search</span> and select your images. You can select all \n"
"by checking the checkbox or filter the images by cloud coverage by moving "
"the slider. Or you can pick images one by one by scrolling \n"
"through the list and selecting them. Via the **Borders** checkbox, you can "
"enable/disable the borders on your image.\n"
"\n"
"You can preview the timelapse by pressing the play button <span "
"class=\"icon\"><i class=\"fas fa-play-circle\"></i></span>, set the speed "
"(frames per second)\n"
"and transition mode, all available at the bottom of the screen. See "
"additional settings by clicking the\n"
"settings icon <span class=\"icon\"><i class=\"fas fa-cogs\"></i></span>.\n"
"\n"
"When you are satisfied with the result, click the download button and the "
"timelapse will be downloaded as a <code>.gif</code> or <code>.mp4</code> "
"file."
msgstr ""
"Pomocí tohoto nástroje (dostupného přihlášeným uživatelům) můžete vytvořit "
"časosběrnou animaci vizualizované vrstvy a zobrazeného místa.\n"
"\n"
"Nejprve zvolte časové období. Výsledky hledání můžete dále upřesnit "
"zaškrtávacím políčkem **Filtrovat podle měsíců** a/nebo výběrem jednoho\n"
"snímku za definované období (oběh, den, týden, měsíc, rok).\n"
"\n"
"Poté stiskněte <span class=\"icon\"><i class=\"fa fa-search\"></i> "
"Hledat</span> a vyberte své snímky. Všechny můžete vybrat \n"
"zaškrtnutím políčka nebo snímky filtrovat podle oblačnosti posunutím "
"posuvníku. Případně můžete snímky vybírat jeden po druhém procházením \n"
"seznamu a jejich označením. Pomocí zaškrtávacího políčka **Hranice** můžete "
"na snímku hranice zapnout či vypnout.\n"
"\n"
"Časosběr si můžete prohlédnout stisknutím tlačítka přehrávání <span "
"class=\"icon\"><i class=\"fas fa-play-circle\"></i></span>, nastavit "
"rychlost (snímků za sekundu)\n"
"a režim přechodu; vše je dostupné ve spodní části obrazovky. Další "
"nastavení zobrazíte kliknutím na\n"
"ikonu nastavení <span class=\"icon\"><i class=\"fas fa-cogs\"></i></span>.\n"
"\n"
"Když budete s výsledkem spokojeni, klikněte na tlačítko stažení a časosběr "
"se stáhne jako soubor <code>.gif</code> nebo <code>.mp4</code>."

msgid ""
"This tool allows you to navigate and fly through terrain effortlessly.\n"
"\n"
"You can make use of the 3D feature by utilising the following tools:\n"
"- Use **Vertical Terrain Scaling** to make flatter areas appear more "
"dynamic\n"
"- Simulate the Sun's movements and its projected shadows at any time of the "
"day\n"
"- Manipulate the **Shadow Parameters**\n"
"  - Shadow visibility\n"
"  - Shadow rendering distance\n"
"  - Shadow map size\n"
"- Control the ambient, diffuse and specular factors as well as specular "
"power\n"
"- Use the **Anaglyph Stereo Mode** to create two distinct red and blue "
"images to produce a single 3D stereo image"
msgstr ""
"Tento nástroj vám umožňuje bez námahy procházet terén a prolétat nad ním.\n"
"\n"
"Funkci 3D můžete využít pomocí následujících nástrojů:\n"
"- Pomocí **Svislého měřítka terénu** zvýrazníte dynamiku plošších oblastí\n"
"- Simulujte pohyb Slunce a vrhané stíny v kteroukoli denní dobu\n"
"- Upravujte **Parametry stínů**\n"
"  - Viditelnost stínů\n"
"  - Vzdálenost vykreslování stínů\n"
"  - Velikost mapy stínů\n"
"- Ovládejte ambientní, difuzní a spekulární faktory i spekulární výkon\n"
"- Pomocí **Anaglyfického stereo režimu** vytvořte dva odlišné červené a "
"modré obrazy a získejte jeden 3D stereo obraz"

msgid ""
"This tool allows you to calculate and display statistical data (the "
"distribution of values) for specific layers.\n"
"\n"
"It is calculated for the data within your AOI (if defined) or otherwise for "
"the whole screen.\n"
"\n"
"You can hover over the bars in the histogram to read the values and "
"determine thresholds to distinguish between different spectral signatures.\n"
"\n"
"This tool currently only works for index layers (e.g. the NDVI)."
msgstr ""
"Tento nástroj umožňuje vypočítat a zobrazit statistická data (rozdělení "
"hodnot) pro určité vrstvy.\n"
"\n"
"Počítá se pro data v rámci vaší AOI (pokud je definována), jinak pro celou "
"obrazovku.\n"
"\n"
"Najetím na sloupce histogramu si můžete přečíst hodnoty a určit prahové "
"hodnoty pro rozlišení různých spektrálních signatur.\n"
"\n"
"Tento nástroj momentálně funguje pouze pro indexové vrstvy (např. NDVI)."

msgid ""
"You have reached the end of the tutorial. If you have any other questions, "
"feel free to ask us on \n"
"[our forum](https://forum.dataspace.copernicus.eu/) or [submit a "
"request](https://helpcenter.dataspace.copernicus.eu/hc/en-gb/requests/new).\n"
"\n"
"If you would like to view the tutorial in the future, you can always access "
"it by clicking the info \n"
"icon <span class=\"icon large-padding\"><i class=\"fa fa-info\"></i></span> "
"in the top right corner."
msgstr ""
"Dostali jste se na konec návodu. Pokud máte další otázky, neváhejte se nás "
"zeptat na \n"
"[našem fóru](https://forum.dataspace.copernicus.eu/) nebo [odešlete "
"požadavek](https://helpcenter.dataspace.copernicus.eu/hc/en-gb/requests/new)"
".\n"
"\n"
"Pokud si chcete návod v budoucnu znovu zobrazit, můžete k němu kdykoli "
"přejít kliknutím na ikonu informací \n"
"<span class=\"icon large-padding\"><i class=\"fa fa-info\"></i></span> v "
"pravém horním rohu."

msgid ""
"#### Quick overview of Copernicus Browser features\n"
"\n"
"If you have a small screen, please go "
"[here](https://documentation.dataspace.copernicus.eu/Applications/Browser."
"html) to view our user guide.\n"
"\n"
"You can always view this info again by clicking the info icon <span "
"class=\"icon large-padding\"><i class=\"fa fa-info\"></i></span> in the top "
"right corner.\n"
"\n"
"#### Other resources\n"
"- [Available data "
"collections](https://dataspace.copernicus.eu/explore-data/data-collections)"
msgstr ""
"#### Stručný přehled funkcí Copernicus Browser\n"
"\n"
"Pokud máte malou obrazovku, přejděte "
"[sem](https://documentation.dataspace.copernicus.eu/Applications/Browser."
"html) a prohlédněte si naši uživatelskou příručku.\n"
"\n"
"Tyto informace si můžete kdykoli znovu zobrazit kliknutím na ikonu "
"informací <span class=\"icon large-padding\"><i class=\"fa "
"fa-info\"></i></span> v pravém horním rohu.\n"
"\n"
"#### Další zdroje\n"
"- [Dostupné datové "
"kolekce](https://dataspace.copernicus.eu/explore-data/data-collections)"

msgid "About Copernicus Browser"
msgstr "O aplikaci Copernicus Browser"

msgid "User Account"
msgstr "Uživatelský účet"

msgid "Visualise Tab"
msgstr "Karta Vizualizace"

msgid "Layers Panel"
msgstr "Panel vrstev"

msgid "Highlights Panel"
msgstr "Panel Zajímavosti"

msgid "Compare Panel"
msgstr "Panel Porovnání"

msgid "Pins Panel"
msgstr "Panel Pinů"

msgid "WMS/WMTS Panel"
msgstr "Panel WMS/WMTS"

msgid "Search Tab"
msgstr "Karta Hledání"

msgid "Search Places"
msgstr "Hledat místa"

msgid "Basemaps and Overlays"
msgstr "Podkladové mapy a překryvy"

msgid "Information and Tutorial"
msgstr "Informace a návod"

msgid "Draw Area of Interest"
msgstr "Nakreslit oblast zájmu"

msgid "Draw a Line"
msgstr "Nakreslit linii"

msgid "Mark Point of Interest"
msgstr "Označit bod zájmu"

msgid "Measure Distances"
msgstr "Měřit vzdálenosti"

msgid "Download Image"
msgstr "Stáhnout obrázek"

msgid "Create Timelapse Animation"
msgstr "Vytvořit časosběrnou animaci"

msgid "Visualise Terrain in 3D"
