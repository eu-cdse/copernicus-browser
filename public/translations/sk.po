msgid ""
"The request to the imagery provider timed out. Please try again in a few "
"minutes."
msgstr ""
"Požiadavka na poskytovateľa snímok vypršala. Skúste to, prosím, znova o "
"niekoľko minút."

msgid ""
"The imagery provider is temporarily unavailable. Please try again in a few "
"minutes."
msgstr ""
"Poskytovateľ snímok je dočasne nedostupný. Skúste to, prosím, znova o "
"niekoľko minút."

msgid ""
"Your search couldn't be processed. This can happen when a search covers "
"many providers or a large area. Try narrowing your search and searching "
"again."
msgstr ""
"Vaše vyhľadávanie sa nepodarilo spracovať. Môže sa to stať, keď "
"vyhľadávanie zahŕňa veľa poskytovateľov alebo rozsiahlu oblasť. Skúste "
"vyhľadávanie zúžiť a vyhľadať znova."

msgid ""
"Unable to reach the imagery provider. Please check your internet connection "
"and try again."
msgstr ""
"Poskytovateľa snímok sa nepodarilo kontaktovať. Skontrolujte, prosím, "
"internetové pripojenie a skúste to znova."

#, javascript-format
msgid ""
"Too many requests to ${ provider }. Please wait a moment and try again, or "
"narrow your search."
msgstr ""
"Príliš veľa požiadaviek na ${ provider }. Chvíľu počkajte a skúste to "
"znova, alebo zúžte vyhľadávanie."

#, javascript-format
msgid ""
"Showing the available results. Some sources did not respond, so more "
