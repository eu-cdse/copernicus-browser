msgid ""
"The evalscript you are using is too long and a short-URL cannot be "
"generated.\n"
"Please shorten your evalscript or save it to a website and use the “Load "
"script from URL” functionality."
msgstr ""
"Evalscript, ktorý používate, je príliš dlhý a krátku URL nie je možné "
"vygenerovať.\n"
"Skráťte, prosím, svoj evalscript alebo ho uložte na webovú stránku a "
"použite funkciu „Načítať skript z URL“."

msgid ""
"The process graph you are using is too long and a short-URL cannot be "
