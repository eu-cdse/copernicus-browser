msgid ""
"The request to the imagery provider timed out. Please try again in a few "
"minutes."
msgstr ""
"Begäran till bildleverantören översteg tidsgränsen. Försök igen om några "
"minuter."

msgid ""
"The imagery provider is temporarily unavailable. Please try again in a few "
"minutes."
msgstr "Bildleverantören är tillfälligt otillgänglig. Försök igen om några minuter."

msgid ""
"Your search couldn't be processed. This can happen when a search covers "
"many providers or a large area. Try narrowing your search and searching "
"again."
msgstr ""
"Din sökning kunde inte behandlas. Det kan hända när en sökning omfattar "
"många leverantörer eller ett stort område. Försök avgränsa sökningen och "
"sök igen."

msgid ""
"Unable to reach the imagery provider. Please check your internet connection "
"and try again."
msgstr ""
"Det gick inte att nå bildleverantören. Kontrollera din internetanslutning "
"och försök igen."

#, javascript-format
msgid ""
"Too many requests to ${ provider }. Please wait a moment and try again, or "
"narrow your search."
msgstr ""
"För många förfrågningar till ${ provider }. Vänta en stund och försök igen, "
"eller avgränsa din sökning."

#, javascript-format
msgid ""
"Showing the available results. Some sources did not respond, so more "
"results may be available: ${ errorMessage }"
msgstr ""
"Visar tillgängliga resultat. Vissa källor svarade inte, så fler resultat "
"kan finnas tillgängliga: ${ errorMessage }"

msgid ""
"The imagery provider is currently receiving too many requests. Please wait "
"a moment and try your search again."
msgstr ""
"Bildleverantören får just nu för många förfrågningar. Vänta en stund och "
"försök söka igen."

