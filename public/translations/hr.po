msgstr "Broj apsolutne orbite u trenutku snimanja."

msgid "Mode used for processing the product, if applicable."
msgstr "Način korišten za obradu proizvoda, ako je primjenjivo."

msgid "Identifiers of the swath(s) used in the acquisition (e.g., IW1, IW2, IW3)."
msgstr "Identifikatori pojasa (swath) korištenih pri snimanju (npr. IW1, IW2, IW3)."

