msgid ""
"The request to the imagery provider timed out. Please try again in a few "
"minutes."
msgstr ""
"Zahtjev prema pružatelju snimaka istekao je. Pokušajte ponovno za nekoliko "
"minuta."

msgid ""
"The imagery provider is temporarily unavailable. Please try again in a few "
"minutes."
msgstr ""
"Pružatelj snimaka privremeno je nedostupan. Pokušajte ponovno za nekoliko "
"minuta."

msgid ""
"Your search couldn't be processed. This can happen when a search covers "
"many providers or a large area. Try narrowing your search and searching "
"again."
msgstr ""
"Vaša pretraga nije mogla biti obrađena. To se može dogoditi kada pretraga "
"obuhvaća mnogo pružatelja ili veliko područje. Pokušajte suziti pretragu i "
"ponovno pretražiti."

msgid ""
"Unable to reach the imagery provider. Please check your internet connection "
"and try again."
msgstr ""
"Nije moguće doseći pružatelja snimaka. Provjerite internetsku vezu i "
"pokušajte ponovno."

#, javascript-format
msgid ""
"Too many requests to ${ provider }. Please wait a moment and try again, or "
"narrow your search."
msgstr ""
"Previše zahtjeva prema pružatelju ${ provider }. Pričekajte trenutak i "
"pokušajte ponovno ili suzite pretragu."

#, javascript-format
msgid ""
"Showing the available results. Some sources did not respond, so more "
"results may be available: ${ errorMessage }"
msgstr ""
"Prikazani su dostupni rezultati. Neki izvori nisu odgovorili pa je moguće "
"da postoje dodatni rezultati: ${ errorMessage }"

msgid ""
"The imagery provider is currently receiving too many requests. Please wait "
"a moment and try your search again."
msgstr ""
"Pružatelj snimaka trenutno prima previše zahtjeva. Pričekajte trenutak i "
"ponovno pokušajte pretragu."

