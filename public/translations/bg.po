msgid "Band 1 - Aerosol correction, improved water constituent retrieval - 400 nm"
msgstr ""
"Канал 1 - Корекция за аерозоли, подобрено извличане на водни съставки - 400 "
"nm"

msgid "Band 2 - Yellow substance and detrital pigments (turbidity)-412.5 nm"
msgstr "Канал 2 - Жълто вещество и детритни пигменти (мътност) - 412.5 nm"

msgid "Band 3 - Chl absorption max., biogeochemistry, vegetation - 442.5 nm"
msgstr ""
"Канал 3 - Максимум на абсорбция на хлорофил, биогеохимия, растителност - "
"442.5 nm"

msgid "Band 4 - High Chl, other pigments - 490 nm"
msgstr "Канал 4 - Високо съдържание на хлорофил, други пигменти - 490 nm"

msgid "Band 5 - Chl, sediment, turbidity, red tide - 510 nm"
msgstr "Канал 5 - Хлорофил, седименти, мътност, червен прилив - 510 nm"

msgid "Band 6 - Chlorophyll reference (Chl minimum) - 560 nm"
msgstr "Канал 6 - Референтен канал за хлорофил (минимум на хлорофил) - 560 nm"

msgid "Band 7 - Sediment loading - 620 nm"
msgstr "Канал 7 - Натоварване със седименти - 620 nm"

msgid ""
"Band 8 - Chl (2nd Chl abs. max.), sediment, yellow substance/vegetation - "
"665 nm"
msgstr ""
"Канал 8 - Хлорофил (2-ри максимум на абсорбция на хлорофил), седименти, "
"жълто вещество/растителност - 665 nm"

msgid ""
"Band 9 - For improved fluorescence retrieval and to better account for "
"spectral smile together with the band 8 (665 nm) and band 10 (681.25 nm) - "
"673.75 nm"
msgstr ""
"Канал 9 - За подобрено извличане на флуоресценция и по-добро отчитане на "
"спектралната усмивка заедно с канал 8 (665 nm) и канал 10 (681.25 nm) - "
"673.75 nm"

msgid "Band 10 - Chl fluorescence peak, red edge - 681.25 nm"
msgstr "Канал 10 - Пик на флуоресценция на хлорофил, червен ръб - 681.25 nm"

msgid "Band 11 - Chl fluorescence baseline, red edge transition - 708.75 nm"
msgstr ""
"Канал 11 - Базова линия на флуоресценцията на хлорофил, преход на червения "
"ръб - 708.75 nm"

msgid "Band 12 - O2 absorption/clouds, vegetation - 753.75 nm"
msgstr "Канал 12 - Абсорбция на O2/облаци, растителност - 753.75 nm"

msgid "Band 13 - O2 absorption band/aerosol corr. - 761.25 nm"
msgstr "Канал 13 - Канал на абсорбция на O2/корекция за аерозоли - 761.25 nm"

msgid "Band 14 - Atmospheric correction - 764.375 nm"
msgstr "Канал 14 - Атмосферна корекция - 764.375 nm"

msgid "Band 15 - O2A used for cloud top pressure, fluorescence over land - 767.5 nm"
msgstr ""
"Канал 15 - O2A, използван за налягане на върха на облаците, флуоресценция "
"над сушата - 767.5 nm"

msgid "Band 16 - Atmos. corr./aerosol corr. - 778.75 nm"
msgstr "Канал 16 - Атмосферна/аерозолна корекция - 778.75 nm"

msgid "Band 17 - Atmos. corr./aerosol corr., clouds, pixel co-registration - 865 nm"
msgstr ""
"Канал 17 - Атмосферна корекция/корекция за аерозоли, облаци, съвместяване "
"на пиксели - 865 nm"

msgid ""
"Band 18 - Water vapour absorption reference band. Common reference band "
"with SLSTR instrument. Vegetation monitoring - 885 nm"
msgstr ""
"Канал 18 - Референтен канал за абсорбция на водни пари. Общ референтен "
"канал с инструмента SLSTR. Мониторинг на растителността - 885 nm"

msgid ""
"Band 19 - Water vapour absorption/vegetation monitoring (max. reflectance) "
"- 900 nm"
msgstr ""
"Канал 19 - Абсорбция на водни пари/мониторинг на растителността (максимална "
"отражателна способност) - 900 nm"

msgid "Band 20 - Water vapour absorption, atmos./aerosol corr. - 940 nm"
msgstr ""
"Канал 20 - Абсорбция на водни пари, атмосферна корекция/корекция за "
"аерозоли - 940 nm"

msgid "Band 21 - Atmos./aerosol corr. - 1020 nm"
msgstr "Канал 21 - Атмосферна/аерозолна корекция - 1020 nm"

msgid "Band F1 - Thermal IR fire emission - Active fire - 3742.00 nm"
msgstr ""
"Канал F1 - Топлинно инфрачервено излъчване от пожари - Активен пожар - "
"3742.00 nm"

